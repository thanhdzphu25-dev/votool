{
  "manifest_version": 3,
  "name": "NO ADS EXTENSION",
  "version": "0.1.0",
  "description": "Tự động chặn quảng cáo trên trình duyệt.",
  "permissions": ["storage", "activeTab", "scripting", "commands"],
  "host_permissions": ["<all_urls>", "https://api.xah.io/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NO ADS EXTENSION",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
